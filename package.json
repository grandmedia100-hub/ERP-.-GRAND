{
  "name": "mediahive",
  "private": true,
  "version": "9.0.0",
  "author": "Mahmoud Fathi",
  "description": "ERP System for MediaHive",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run client\" \"wait-on tcp:3000 && electron .\"",
    "package": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.mediahive.erp",
    "productName": "MediaHive ERP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "portable": {
      "artifactName": "MediaHive-ERP-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MediaHive ERP",
      "artifactName": "MediaHive-ERP-Setup.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
