{
    "name": "mediahive-clean",
    "private": true,
    "version": "10.1.0-clean",
    "author": "Mahmoud Fathi",
    "description": "ERP System for MediaHive - Clean Install (Empty Database)",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "dev:host": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron .",
        "electron:dev": "concurrently \"npm run client\" \"wait-on tcp:3000 && electron .\"",
        "package": "vite build && electron-builder"
    },
    "build": {
        "appId": "com.mediahive.erp.clean",
        "productName": "MediaHive ERP - Clean Install",
        "asar": true,
        "directories": {
            "output": "dist-electron-v10.1-clean"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "server/server-clean.js",
            "server/mediahive-clean.db",
            "server/package.json",
            "server/node_modules/**/*",
            "server/.env",
            "package.json"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "shortcutName": "MediaHive ERP - Clean"
        }
    },
    "dependencies": {
        "@google/genai": "^1.29.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "recharts": "^3.6.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/node": "^22.14.0",
        "@vitejs/plugin-react": "^5.0.0",
        "autoprefixer": "^10.4.23",
        "electron": "^39.2.7",
        "electron-builder": "^26.0.12",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.8.2",
        "vite": "^6.2.0"
    }
}